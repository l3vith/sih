{
  "name": "nwis-mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:companion": "tsc -b && vite build --mode companion",
    "preview": "vite preview",
    "ocr-server": "node server.mjs",
    "dev:all": "node scripts/ocr-runtime.mjs start && concurrently --kill-others --names web,api \"vite\" \"node server.mjs\"",
    "ocr:start": "node scripts/ocr-runtime.mjs start",
    "ocr:stop": "node scripts/ocr-runtime.mjs stop",
    "ocr:logs": "node scripts/ocr-runtime.mjs logs",
    "test:ocr": "node --test server/*.test.mjs",
    "ocr:setup": "node scripts/ocr-runtime.mjs setup",
    "ocr:status": "node scripts/ocr-runtime.mjs status"
  },
  "dependencies": {
    "@equinor/videx-3d": "^3.2.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@google/genai": "^2.21.0",
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.115.0",
    "@vitejs/plugin-react": "latest",
    "comlink": "^4.4.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "groq": "^6.12.0",
    "groq-sdk": "^1.6.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "latest",
    "maplibre-gl": "^6.7.0",
    "pdfjs-dist": "^6.3.289",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.179.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
