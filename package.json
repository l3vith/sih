{
  "name": "nwis-mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ocr-server": "node server.mjs",
    "dev:all": "node scripts/ocr-runtime.mjs start && concurrently --kill-others --names web,api \"vite\" \"node server.mjs\"",
    "ocr:start": "node scripts/ocr-runtime.mjs start",
    "ocr:stop": "node scripts/ocr-runtime.mjs stop",
    "ocr:logs": "node scripts/ocr-runtime.mjs logs",
    "test:ocr": "node --test server/mlx-ocr.test.mjs server/report-normalization.test.mjs",
    "ocr:setup": "node scripts/ocr-runtime.mjs setup",
    "ocr:status": "node scripts/ocr-runtime.mjs status"
  },
  "dependencies": {
    "@equinor/videx-3d": "^3.2.2",
    "@google/genai": "^2.21.0",
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.115.0",
    "@vitejs/plugin-react": "latest",
    "comlink": "^4.4.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq": "^6.12.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "latest",
    "maplibre-gl": "^6.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.34.5",
    "three": "^0.179.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5"
  }
}
