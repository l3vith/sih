GROQ_API_KEY=replace_with_a_new_rotated_key
GOOGLE_API_KEY=replace_with_google_key
GOOGLE_MODEL=gemma-4-26b-a4b-it
OSAURUS_URL=http://127.0.0.1:1337
OSAURUS_MODEL=gemma-4-e2b-it-qat-mxfp4
PORT=8787

# Supabase — create project at https://supabase.com/dashboard then copy URL + anon/service keys
# Frontend (Vite) needs VITE_ prefix; server reads both VITE_ and plain names
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Or for local-only mode, leave Supabase vars empty — app falls back to in-memory + local blob URLs

# Native Apple Silicon OCR (MLX / Metal)
MLX_OCR_URL=http://127.0.0.1:8080
MLX_OCR_PORT=8080
MLX_OCR_MODEL=mlx-community/GLM-OCR-bf16
MLX_OCR_MAX_TOKENS=8192
MLX_OCR_TIMEOUT_MS=600000

# Cross-platform OCR engine selection: auto (default) | mlx | tesseract
# auto = MLX GLM-OCR on macOS (Tesseract fallback if unreachable),
# Tesseract directly on Windows/Linux. Set OCR_ENGINE=tesseract to force
# the fallback anywhere (e.g. testing the Windows path on a Mac).
OCR_ENGINE=auto
# Tesseract fallback languages and on-disk cache (downloaded once, offline after).
TESSERACT_LANGS=eng+hin
TESSERACT_CACHE=.tesseract-cache
